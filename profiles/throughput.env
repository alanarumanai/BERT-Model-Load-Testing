# Recommended production profile, throughput first (report: Stage 5, conclusion 5.1).
# int8 dynamic quantization, 8 single-threaded workers, at most 2 predictions per worker.
# Measured on 8 cores: 491.6 req/s peak (3.8x the default), SST-2 accuracy 89.91%.
# Assumes 8 CPUs for the service; set GUNICORN_WORKERS to the number of CPUs you give it.
GUNICORN_WORKERS=8
APP_TORCH_NUM_THREADS=1
APP_MAX_CONCURRENT_PREDICTIONS=2
APP_QUANTIZE=true